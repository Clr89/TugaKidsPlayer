# Exemplo de configuração de keystore para release (versão v1.0.0)
# Copie este ficheiro para 'keystore.properties' (que está ignorado pelo Git)
# e preencha com os caminhos e palavras-passe reais do seu keystore externo.
#
# Exemplo de caminho absoluto ou relativo ao projeto:
storeFile=C:/Caminho/Para/O/Seu/keystore.jks
storePassword=sua_store_password_aqui
keyAlias=seu_key_alias_aqui
keyPassword=sua_key_password_aqui
